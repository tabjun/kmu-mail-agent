# ===== Claude API (연구실 조직 키 — 담당자에게 받아서 채우세요) =====
ROOT_API_KEY=
# 조직 범위 키(sk-ant-usr-…)는 워크스페이스 ID가 필요합니다: Console > 설정 > 워크스페이스
ANTHROPIC_WORKSPACE_ID=

# ===== Microsoft 365 앱 (공용 클라이언트 ID — 비밀값 아님, 그대로 두세요) =====
MS_CLIENT_ID=b56e9ef8-b73f-4257-b900-33dee9da3300
MS_TENANT=common

# ===== 동작 (대부분은 웹 화면의 설정이 우선합니다) =====
CALENDAR_PROVIDER=outlook           # outlook | google | ics | none
NOTIFIERS=console,file              # + outlook_mail, webhook
# NOTIFY_WEBHOOK_URL=
# MAIL_SOURCE=sample                # 데모: 샘플 메일로 실행
TIMEZONE=Asia/Seoul

# ===== 분류 API / Outlook 애드인 =====
API_AUTH_MODE=dev                   # dev | entra
# API_KEY=
# API_AUDIENCE=api://localhost:3000/<MS_CLIENT_ID>
# API_ALLOWED_TENANTS=
API_ALLOWED_ORIGINS=https://localhost:3000

# Gmail 사용자의 일정을 같은 Gmail의 Google 캘린더에 넣을 때 (Google Cloud OAuth '데스크톱 앱' 클라이언트)
# 공개 저장소에 넣지 말고 키 파일(.env)로만 전달합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
